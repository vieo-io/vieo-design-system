{
	"name": "@vieo-io/ui",
	"version": "0.1.0",
	"description": "Vieo's components in Solid 2.0, styled by @vieo-io/tokens",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vieo-io/vieo-design-system.git",
		"directory": "packages/ui"
	},
	"engines": {
		"node": ">=22.12"
	},
	"files": [
		"dist",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"solid": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/*.css dist/",
		"test": "vitest run && tsc --noEmit -p .",
		"prepublishOnly": "pnpm build"
	},
	"peerDependencies": {
		"@solidjs/web": "^2.0.3",
		"@vieo-io/tokens": "^0.1.0",
		"solid-js": "^2.0.3"
	},
	"dependencies": {
		"@floating-ui/dom": "1.8.0",
		"@solid-primitives/focus": "1.0.0"
	},
	"devDependencies": {
		"@solidjs/testing-library": "1.0.0-rc.2",
		"@solidjs/vite-plugin": "3.0.1",
		"@solidjs/web": "2.0.3",
		"@vieo-io/tokens": "workspace:*",
		"jsdom": "31.0.1",
		"solid-js": "2.0.3",
		"vite": "8.3.8",
		"vitest": "5.1.1"
	},
	"sideEffects": [
		"**/*.css"
	]
}
