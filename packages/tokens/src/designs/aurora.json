{
	"default": {
		"typography": {
			"font-title": {
				"$value": "clamp(30px, 4.2vw, 42px)"
			},
			"tracking-title": {
				"$value": "-0.02em"
			},
			"weight-strong": {
				"$value": "650"
			}
		},
		"radius": {
			"radius-xs": {
				"$value": "8px"
			},
			"radius-sm": {
				"$value": "10px"
			},
			"radius-md": {
				"$value": "14px"
			},
			"radius-lg": {
				"$value": "20px"
			}
		},
		"color": {
			"shadow-tint": {
				"$type": "color",
				"$value": "color-mix(in srgb, {color.accent} 50%, black)"
			}
		},
		"shadow": {
			"shadow-1": {
				"$value": "0 1px 2px color-mix(in srgb, {color.shadow-tint} 6%, transparent)"
			},
			"shadow-2": {
				"$value": "0 2px 6px color-mix(in srgb, {color.shadow-tint} 8%, transparent), 0 10px 24px -8px color-mix(in srgb, {color.shadow-tint} 14%, transparent)"
			},
			"shadow-pop": {
				"$value": "0 24px 60px -12px color-mix(in srgb, {color.shadow-tint} 30%, transparent)"
			}
		},
		"motion": {
			"dur": {
				"$value": "160ms"
			}
		}
	},
	"dark": {
		"shadow": {
			"shadow-1": {
				"$value": "0 1px 2px rgb(0 0 0 / 34%)"
			},
			"shadow-2": {
				"$value": "0 2px 6px rgb(0 0 0 / 40%), 0 10px 24px -8px rgb(0 0 0 / 50%)"
			},
			"shadow-pop": {
				"$value": "0 24px 60px -12px rgb(0 0 0 / 66%)"
			}
		}
	}
}
